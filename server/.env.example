# ============================================
# AIB+ Backend — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.

# Anthropic API Key for the Product Owner Engine
ANTHROPIC_API_KEY=your-anthropic-api-key-here

PORT=3001

# Modelo de Claude a usar. Opcional; por defecto claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-5

# Modelo de ABI, el asistente del ingeniero, y cuánto piensa antes de
# responder (low | medium | high). Opcionales.
# ABI_MODEL=claude-opus-5-5
# ABI_EFFORT=medium

# Origenes permitidos por CORS, separados por comas. Opcional en local
# (por defecto los puertos de Vite). Obligatorio en produccion.
# ALLOWED_ORIGINS=https://tu-dominio.com

# Credenciales de Supabase para validar la sesion de quien llama a la API.
# Son los mismos valores que usa el frontend; la clave anonima es publica por
# diseno, lo que autoriza es el token del usuario.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Aviso por correo al ingeniero cuando un cliente acepta un encargo. Opcional:
# sin estas variables no se envía nada. Crea una cuenta gratis en resend.com y
# una API key. Sin dominio propio verificado, AVISOS_CORREO debe ser el mismo
# correo con el que te registraste en Resend.
# RESEND_API_KEY=re_xxxxxxxx
# AVISOS_CORREO=tu-correo@ejemplo.com
# AVISOS_REMITENTE=AIB+ <onboarding@resend.dev>
# APP_URL=https://aib-core.vercel.app

# Aviso por WhatsApp al ingeniero con CallMeBot (gratis, solo para avisarse a
# uno mismo). Guarda +34 611 021 695 en tus contactos, mándale por WhatsApp
# "I allow callmebot to send me messages" y te responde con tu clave.
# AVISOS_WHATSAPP=51987654321
# CALLMEBOT_APIKEY=1234567
