# ============================================
# AIB+ Backend — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.

# Anthropic API Key for the Product Owner Engine
ANTHROPIC_API_KEY=your-anthropic-api-key-here

PORT=3001

# Modelo de Claude a usar. Opcional; por defecto claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-5

# Origenes permitidos por CORS, separados por comas. Opcional en local
# (por defecto los puertos de Vite). Obligatorio en produccion.
# ALLOWED_ORIGINS=https://tu-dominio.com
