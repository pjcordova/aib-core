{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aib-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "server",
      "port": 3001
    },
    {
      "name": "aib-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "Proyecto_AIB",
      "port": 3000
    },
    {
      "name": "aib-web-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "Proyecto_AIB",
      "port": 4173
    }
  ]
}
