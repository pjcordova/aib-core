# ============================================
# AIB+ SaaS Engine — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.

# Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (found in Project Settings > API > anon/public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL del backend orquestador. Opcional en local (por defecto http://localhost:3001).
# En despliegue apunta al dominio publico del servidor Express.
VITE_API_URL=http://localhost:3001
